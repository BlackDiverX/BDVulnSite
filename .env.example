# BD VulnSite — пример переменных окружения
# ==========================================
# Скопируйте этот файл в .env:
#
#     cp .env.example .env
#
# .env НЕ должен попадать в git (см. .gitignore).

# --- База данных ---
DB_HOST=db
DB_USER=admin
DB_PASSWORD=MegaPassword1!
DB_NAME=portal

# --- Root-пароль MariaDB (только для контейнера db) ---
DB_ROOT_PASSWORD=root

# --- Порт, на котором будет доступен сайт ---
WEB_PORT=8080

# --- Секрет для HMAC-хешей флагов ---
# Поменяй на свою случайную строку и пересчитай хеши в flags.php
# командой: FLAG_SECRET=... php tools/hash_flag.php "flag{...}"
FLAG_SECRET=bdvulnsite-secret-2026